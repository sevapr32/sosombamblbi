-- Основные сервисы
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- Получаем игрока и его GUI
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Таблица для хранения всех созданных элементов
local elements = {}
local animations = {}

-- Функция создания элемента с анимацией появления
local function createElement(className, properties, parent)
    local element = Instance.new(className)
    
    -- Применяем свойства
    for property, value in pairs(properties) do
        if property ~= "Parent" then
            element[property] = value
        end
    end
    
    -- Добавляем анимацию появления
    if className == "Frame" or className == "TextButton" or className == "TextBox" then
        element.BackgroundTransparency = 1
        animations[element] = {
            transparency = 1,
            target = 0
        }
    elseif className == "TextLabel" or className == "TextButton" then
        element.TextTransparency = 1
        animations[element] = {
            textTransparency = 1,
            target = 0
        }
    end
    
    -- Устанавливаем родителя
    if parent then
        element.Parent = parent
    end
    
    table.insert(elements, element)
    return element
end

-- Функция плавного появления
local function fadeIn(element, duration)
    if element:IsA("Frame") or element:IsA("TextButton") or element:IsA("TextBox") then
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(element, tweenInfo, {BackgroundTransparency = 0})
        tween:Play()
    end
    
    if element:IsA("TextLabel") or element:IsA("TextButton") or element:IsA("TextBox") then
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(element, tweenInfo, {TextTransparency = 0})
        tween:Play()
    end
end

