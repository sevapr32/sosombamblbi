local function initializeChat()
	print("🚀 Инициализация автономного чата...")
	
	-- Создаем все элементы GUI
	local chatFrame = createChatFrame()
	local topBar, closeButton = createTopBar(chatFrame)
	local messagesScroll = createMessagesArea(chatFrame)
	local inputFrame, inputBox = createInputArea(chatFrame)
	
	print("✅ Все элементы GUI созданы")
	
	-- ========== ОБРАБОТЧИКИ СОБЫТИЙ ==========
	
	-- Обработчик перетаскивания
	topBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or 
		   input.UserInputType == Enum.UserInputType.Touch then
			
			isDragging = true
			dragStartPos = input.Position
			frameStartPos = chatFrame.Position
			lastActivity = tick()
		end
	end)
	
	game:GetService("UserInputService").InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
						  input.UserInputType == Enum.UserInputType.Touch) then
			
			local delta = input.Position - dragStartPos
			chatFrame.Position = UDim2.new(
				frameStartPos.X.Scale,
				frameStartPos.X.Offset + delta.X,
				frameStartPos.Y.Scale,
				frameStartPos.Y.Offset + delta.Y
			)
			lastActivity = tick()
		end
	end)
	
	game:GetService("UserInputService").InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or 
		   input.UserInputType == Enum.UserInputType.Touch then
			
			isDragging = false
		end
	end)
	
	-- Обработчик отправки сообщений
	inputBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			sendMessage(inputBox, messagesScroll)
		end
	end)
	
	-- Обработчик горячих клавиш
	game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not isActive then return end
		
		if input.KeyCode == Enum.KeyCode.Return then
			if inputBox:IsFocused() then
				sendMessage(inputBox, messagesScroll)
			else
				inputBox:CaptureFocus()
				lastActivity = tick()
			end
			
		elseif input.KeyCode == Enum.KeyCode.Slash then
			inputBox:CaptureFocus()
			lastActivity = tick()
			
		elseif input.KeyCode == Enum.KeyCode.Escape then
			if inputBox:IsFocused() then
				inputBox:ReleaseFocus()
				inputBox.Text = ""
			end
		end
	end)
	
	-- Обработчик кнопки закрытия
	closeButton.MouseButton1Click:Connect(closeChat)
	
	-- Эффекты при наведении на кнопку закрытия
	closeButton.MouseEnter:Connect(function()
		if isActive then
			closeButton.BackgroundTransparency = 0
		end
	end)
	
	closeButton.MouseLeave:Connect(function()
		if isActive then
			closeButton.BackgroundTransparency = 0.1
		end
	end)
	
	-- Система автоскрытия
	task.spawn(function()
		while isActive do
			local currentTime = tick()
			local inactiveTime = currentTime - lastActivity
			
			if inactiveTime > 15 then -- 15 секунд неактивности
				local transparency = 0.05 + (inactiveTime - 15) * 0.05
				chatFrame.BackgroundTransparency = math.min(0.8, transparency)
			else
				chatFrame.BackgroundTransparency = 0.05
			end
			
			task.wait(0.5)
		end
	end)
	
	-- Добавляем начальные сообщения
	task.wait(1)
	
	addMessageToChat(messagesScroll, "💜 СИСТЕМА", "Автономный чат создан!", COLOR.LIGHT_PURPLE)
	task.wait(1)
	addMessageToChat(messagesScroll, "💜 СИСТЕМА", "GUI нарисовал себя сам!", COLOR.PURPLE)
	task.wait(1)
	addMessageToChat(messagesScroll, "💜 СИСТЕМА", "Тащите за верхнюю панель", COLOR.LAVENDER)
	task.wait(1)
	addMessageToChat(messagesScroll, "💜 СИСТЕМА", "✕ - закрыть чат", COLOR.RED)
	task.wait(1)
	addMessageToChat(messagesScroll, "💜 СИСТЕМА", "Готов к общению!", COLOR.LIGHT_PURPLE)
	
	print("🎉 Автономный чат полностью инициализирован!")
	print("📊 Сообщений в истории: " .. #messageHistory)
end

