-- Общая функция обработки начала перетаскивания
local function StartDragging(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or 
	   input.UserInputType == Enum.UserInputType.Touch then
		
		isDragging = true
		dragStart = input.Position
		chatStartPos = chatFrame.Position
		
		-- Визуальная обратная связь
		topBar.BackgroundTransparency = 0.2
		stroke.Transparency = 0
		lastActivity = tick()
		
		-- Вибрация на мобильных
		if IS_MOBILE then
			UserInputService:SetMouseIcon("rbxassetid://6065821980")
		end
	end
end

-- Общая функция обработки движения
local function ProcessDragging(input)
	if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
					  input.UserInputType == Enum.UserInputType.Touch) then
		
		local delta = input.Position - dragStart
		local newPosition = UDim2.new(
			chatStartPos.X.Scale,
			chatStartPos.X.Offset + delta.X,
			chatStartPos.Y.Scale,
			chatStartPos.Y.Offset + delta.Y
		)
		
		-- Ограничиваем позицию экраном
		chatFrame.Position = ClampToScreen(newPosition)
		lastActivity = tick()
	end
end

-- Общая функция окончания перетаскивания
local function StopDragging(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or 
	   input.UserInputType == Enum.UserInputType.Touch then
		
		isDragging = false
		topBar.BackgroundTransparency = 0
		stroke.Transparency = 0.1
		
		if IS_MOBILE then
			UserInputService:SetMouseIcon("")
		end
	end
end

-- Подключаем обработчики для всех типов ввода
topBar.InputBegan:Connect(StartDragging)
UserInputService.InputChanged:Connect(ProcessDragging)
UserInputService.InputEnded:Connect(StopDragging)

-- Также позволяем перетаскивать за всю область чата на мобильных
if IS_MOBILE then
	chatFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			StartDragging(input)
		end
	end)
end

