local function AddMessage(sender, text, color)
	if not isActive then return end
	
	local messageContainer = Instance.new("Frame")
	messageContainer.Name = "MessageContainer"
	messageContainer.Size = UDim2.new(1, 0, 0, 0)
	messageContainer.BackgroundTransparency = 1
	messageContainer.AutomaticSize = Enum.AutomaticSize.Y
	messageContainer.LayoutOrder = #messageHistory + 1
	
	local horizontalLayout = Instance.new("UIListLayout")
	horizontalLayout.Padding = UDim.new(0, 4)
	horizontalLayout.FillDirection = Enum.FillDirection.Horizontal
	horizontalLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	horizontalLayout.SortOrder = Enum.SortOrder.LayoutOrder
	horizontalLayout.Parent = messageContainer
	
	local timeLabel = Instance.new("TextLabel")
	timeLabel.Size = UDim2.new(0, 45, 0, 20)
	timeLabel.BackgroundTransparency = 1
	timeLabel.Text = "[" .. os.date("%H:%M") .. "]"
	timeLabel.TextColor3 = COLORS.LIGHT
	timeLabel.TextSize = 12
	timeLabel.TextXAlignment = Enum.TextXAlignment.Left
	timeLabel.Font = Enum.Font.SourceSansSemibold
	timeLabel.LayoutOrder = 1
	timeLabel.Parent = messageContainer
	
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0, 0, 0, 20)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = sender .. ": "
	nameLabel.TextColor3 = color or COLORS.TEXT
	nameLabel.TextSize = 14
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Font = Enum.Font.SourceSansSemibold
	nameLabel.AutomaticSize = Enum.AutomaticSize.X
	nameLabel.LayoutOrder = 2
	nameLabel.Parent = messageContainer
	
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, -70, 0, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = text
	textLabel.TextColor3 = COLORS.TEXT
	textLabel.TextSize = 14
	textLabel.TextXAlignment = Enum.TextXAlignment.Left
	textLabel.TextYAlignment = Enum.TextYAlignment.Top
	textLabel.Font = Enum.Font.SourceSans
	textLabel.TextWrapped = true
	textLabel.AutomaticSize = Enum.AutomaticSize.Y
	textLabel.LayoutOrder = 3
	textLabel.Parent = messageContainer
	
	messageContainer.Parent = messagesFrame
	
	table.insert(messageHistory, {
		sender = sender,
		text = text,
		time = os.date("%H:%M")
	})
	
	task.wait()
	messagesFrame.CanvasPosition = Vector2.new(0, messagesFrame.AbsoluteCanvasSize.Y)
	
	lastActivity = tick()
end

-- ФУНКЦИЯ ОТПРАВКИ СООБЩЕНИЯ
local function SendMessage()
	if not isActive then return end
	
	local text = inputBox.Text:gsub("^%s*(.-)%s*$", "%1")
	
	if #text > 0 then
		AddMessage(player.Name, text, Color3.fromRGB(
			math.random(100, 200),
			math.random(150, 255),
			math.random(150, 255)
		))
		inputBox.Text = ""
	end
	
	inputBox:ReleaseFocus()
end

-- ФУНКЦИЯ ЗАКРЫТИЯ ЧАТА
local function CloseChat()
	if not isActive then return end
	
	isActive = false
	
	for i = 1, 15 do
		chatFrame.BackgroundTransparency = i/15
		topBar.BackgroundTransparency = i/15
		chatStroke.Transparency = i/15
		task.wait(0.03)
	end
	
	screenGui:Destroy()
end

-- ПОДКЛЮЧАЕМ СОБЫТИЯ

-- ПЕРЕТАСКИВАНИЕ
topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or 
	   input.UserInputType == Enum.UserInputType.Touch then
		
		isDragging = true
		dragStart = input.Position
		frameStartPos = chatFrame.Position
		lastActivity = tick()
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
					  input.UserInputType == Enum.UserInputType.Touch) then
		
		local delta = input.Position - dragStart
		chatFrame.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
		lastActivity = tick()
	end
end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or 
	   input.UserInputType == Enum.UserInputType.Touch then
		
		isDragging = false
	end
end)

-- ОТПРАВКА СООБЩЕНИЙ
inputBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		SendMessage()
	end
end)

-- ГОРЯЧИЕ КЛАВИШИ
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
	if processed or not isActive then return end
	
	if input.KeyCode == Enum.KeyCode.Return then
		if inputBox:IsFocused() then
			SendMessage()
		else
			inputBox:CaptureFocus()
			lastActivity = tick()
		end
		
	elseif input.KeyCode == Enum.KeyCode.Slash then
		inputBox:CaptureFocus()
		lastActivity = tick()
		
	elseif input.KeyCode == Enum.KeyCode.Escape then
		if inputBox:IsFocused() then
			inputBox:ReleaseFocus()
			inputBox.Text = ""
		end
	end
end)

-- КНОПКА ЗАКРЫТИЯ
closeButton.MouseButton1Click:Connect(CloseChat)

-- ЭФФЕКТЫ КНОПКИ ЗАКРЫТИЯ
closeButton.MouseEnter:Connect(function()
	if isActive then
		closeButton.BackgroundTransparency = 0
	end
end)

closeButton.MouseLeave:Connect(function()
	if isActive then
		closeButton.BackgroundTransparency = 0.1
	end
end)

-- СИСТЕМА АВТОСКРЫТИЯ
task.spawn(function()
	while isActive do
		local currentTime = tick()
		local inactiveTime = currentTime - lastActivity
		
		if inactiveTime > 15 then
			local transparency = 0.1 + (inactiveTime - 15) * 0.05
			chatFrame.BackgroundTransparency = math.min(0.8, transparency)
		else
			chatFrame.BackgroundTransparency = 0.1
		end
		
		task.wait(0.5)
	end
end)

