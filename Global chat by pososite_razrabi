local function SendMessage()
	if not isChatActive then return end
	
	local text = inputBox.Text:gsub("^%s*(.-)%s*$", "%1")
	
	if #text > 0 then
		local playerColor = Color3.new(
			math.random(100, 200)/255,
			math.random(150, 255)/255,
			math.random(180, 255)/255
