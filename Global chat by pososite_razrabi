-- ========== ФУНКЦИИ ЧАТА ==========

-- Добавление сообщения
local function AddMessage(playerName, message, color)
	-- Ограничение длины
	if #message > 200 then
		message = message:sub(1, 200) .. "..."
	end
	
	-- Сохранение в историю
	table.insert(chatHistory, {
		player = playerName,
		message = message,
		time = os.date("%H:%M"),
		color = color or PURPLE.TEXT
	})
	
	-- Ограничение истории
	while #chatHistory > Settings.MAX_MESSAGES do
		table.remove(chatHistory, 1)
	end
	
	-- Создание визуального сообщения
	local msgFrame = Instance.new("Frame")
	msgFrame.Size = UDim2.new(1, 0, 0, 0)
	msgFrame.BackgroundTransparency = 1
	msgFrame.AutomaticSize = Enum.AutomaticSize.Y
	msgFrame.LayoutOrder = #chatHistory
	
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = msgFrame
	
	-- Время
	local timeLabel = Instance.new("TextLabel")
	timeLabel.Size = UDim2.new(0, 40, 0, 20)
	timeLabel.BackgroundTransparency = 1
	timeLabel.Text = "[" .. os.date("%H:%M") .. "]"
	timeLabel.TextColor3 = PURPLE.ACCENT
	timeLabel.TextSize = 12
	timeLabel.TextXAlignment = Enum.TextXAlignment.Left
	timeLabel.Font = Enum.Font.SourceSansSemibold
	timeLabel.LayoutOrder = 1
	timeLabel.Parent = msgFrame
	
	-- Имя игрока
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0, 0, 0, 20)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = playerName .. ": "
	nameLabel.TextColor3 = color or PURPLE.TEXT
	nameLabel.TextSize = 14
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Font = Enum.Font.SourceSansSemibold
	nameLabel.AutomaticSize = Enum.AutomaticSize.X
	nameLabel.LayoutOrder = 2
	nameLabel.Parent = msgFrame
	
	-- Текст сообщения
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, -50, 0, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = message
	textLabel.TextColor3 = PURPLE.LIGHT
	textLabel.TextSize = 14
	textLabel.TextXAlignment = Enum.TextXAlignment.Left
	textLabel.TextYAlignment = Enum.TextYAlignment.Top
	textLabel.Font = Enum.Font.SourceSans
	textLabel.TextWrapped = true
	textLabel.AutomaticSize = Enum.AutomaticSize.Y
	textLabel.LayoutOrder = 3
	textLabel.Parent = msgFrame
	
	-- Добавление в окно чата
	msgFrame.Parent = messagesFrame
	
	-- Автопрокрутка вниз
	task.wait(0.05)
	messagesFrame.CanvasPosition = Vector2.new(0, messagesFrame.AbsoluteCanvasSize.Y)
	
	-- Обновление активности
	lastActivity = tick()
	chatFrame.BackgroundTransparency = 0.1
end

-- Отправка сообщения
local function SendMessage()
	local text = inputBox.Text:gsub("^%s*(.-)%s*$", "%1")
	
	if #text > 0 then
		AddMessage(Player.Name, text, Color3.fromRGB(100, 255, 100))
		inputBox.Text = ""
	end
	
	inputBox:ReleaseFocus()
end

-- ========== ПЕРЕТАСКИВАНИЕ ==========

-- Начало перетаскивания
topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDragging = true
		dragStart = input.Position
		chatStartPos = chatFrame.Position
		
		-- Визуальная обратная связь
		topBar.BackgroundTransparency = 0.2
		lastActivity = tick()
	end
end)

-- Процесс перетаскивания
UserInputService.InputChanged:Connect(function(input)
	if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		chatFrame.Position = UDim2.new(
			chatStartPos.X.Scale,
			chatStartPos.X.Offset + delta.X,
			chatStartPos.Y.Scale,
			chatStartPos.Y.Offset + delta.Y
		)
		lastActivity = tick()
	end
end)

-- Конец перетаскивания
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDragging = false
		topBar.BackgroundTransparency = 0.05
	end
end)

-- ========== УПРАВЛЕНИЕ ВВОДОМ ==========

-- Отправка по Enter
inputBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		SendMessage()
	end
end)

-- Горячие клавиши
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	
	if input.KeyCode == Enum.KeyCode.Return then
		if inputBox:IsFocused() then
			SendMessage()
		else
			inputBox:CaptureFocus()
			lastActivity = tick()
			chatFrame.BackgroundTransparency = 0.1
		end
		
	elseif input.KeyCode == Enum.KeyCode.Slash then
		inputBox:CaptureFocus()
		lastActivity = tick()
		chatFrame.BackgroundTransparency = 0.1
		
	elseif input.KeyCode == Enum.KeyCode.Escape then
		if inputBox:IsFocused() then
			inputBox:ReleaseFocus()
			inputBox.Text = ""
		end
	end
end)

-- ========== СИСТЕМА АВТОСКРЫТИЯ ==========

task.spawn(function()
	while true do
		local currentTime = tick()
		local inactiveTime = currentTime - lastActivity
		
		-- Плавное скрытие при неактивности
		if inactiveTime > Settings.FADE_TIME then
			chatFrame.BackgroundTransparency = math.min(0.7, 0.1 + (inactiveTime - Settings.FADE_TIME) * 0.1)
		else
			chatFrame.BackgroundTransparency = 0.1
		end
		
		task.wait(0.5)
	end
end)

