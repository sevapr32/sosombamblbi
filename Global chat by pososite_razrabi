-- Функция центрирования по умолчанию
local function GetCenterPosition()
	if IS_MOBILE then
		-- Для телефона - чуть выше центра
		return UDim2.new(0.5, -Settings.CHAT_WIDTH/2, 0.4, -Settings.CHAT_HEIGHT/2)
	else
		-- Для ПК - по центру
		return UDim2.new(0.5, -Settings.CHAT_WIDTH/2, 0.5, -Settings.CHAT_HEIGHT/2)
	end
end

-- Функция ограничения позиции (чтобы не выходил за экран)
local function ClampToScreen(position)
	local screenSize = PlayerGui.AbsoluteSize
	local chatSize = Vector2.new(Settings.CHAT_WIDTH, Settings.CHAT_HEIGHT)
	
	-- Преобразуем UDim2 в пиксели
	local xPos = position.X.Scale * screenSize.X + position.X.Offset
	local yPos = position.Y.Scale * screenSize.Y + position.Y.Offset
	
	-- Ограничиваем
	xPos = math.clamp(xPos, 0, screenSize.X - chatSize.X)
	yPos = math.clamp(yPos, 0, screenSize.Y - chatSize.Y)
	
	-- Преобразуем обратно в UDim2
	return UDim2.new(0, xPos, 0, yPos)
end

