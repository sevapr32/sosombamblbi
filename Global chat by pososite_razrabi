		sendButton.MouseButton1Click:Connect(SendMessage)
		
		-- Также закрываем клавиатуру при отправке
		sendButton.MouseButton1Click:Connect(function()
			inputBox:ReleaseFocus()
		end)
	end
end

-- Горячие клавиши для ПК
if IS_DESKTOP then
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		
		if input.KeyCode == Enum.KeyCode.Return then
			if inputBox:IsFocused() then
				SendMessage()
			else
				inputBox:CaptureFocus()
				lastActivity = tick()
				chatFrame.BackgroundTransparency = 0.08
			end
			
		elseif input.KeyCode == Enum.KeyCode.Slash then
			inputBox:CaptureFocus()
			lastActivity = tick()
			chatFrame.BackgroundTransparency = 0.08
			
		elseif input.KeyCode == Enum.KeyCode.Escape then
			if inputBox:IsFocused() then
				inputBox:ReleaseFocus()
				inputBox.Text = ""
			end
		end
	end)
end

-- Автофокус на мобильных при тапе
if IS_MOBILE then
	inputBox.MouseButton1Click:Connect(function()
		inputBox:CaptureFocus()
		lastActivity = tick()
		chatFrame.BackgroundTransparency = 0.08
	end)
end

-- ========== СИСТЕМА АВТОСКРЫТИЯ ==========

task.spawn(function()
	while true do
		local currentTime = tick()
		local inactiveTime = currentTime - lastActivity
		
		-- Плавное скрытие при неактивности
		if inactiveTime > Settings.FADE_TIME then
			local transparency = 0.08 + (inactiveTime - Settings.FADE_TIME) * 0.05
			chatFrame.BackgroundTransparency = math.min(0.7, transparency)
			stroke.Transparency = 0.5
		else
			chatFrame.BackgroundTransparency = 0.08
			stroke.Transparency = 0.1
		end
		
		task.wait(0.5)
	end
end)

