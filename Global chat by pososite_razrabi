-- Функция отправки сообщения
local function sendMessage(inputBox, scrollFrame)
	if not isActive then return end
	
	local message = inputBox.Text:gsub("^%s*(.-)%s*$", "%1")
	
	if #message > 0 then
		-- Случайный цвет для игрока
		local playerColor = Color3.fromRGB(
			math.random(100, 200),
			math.random(150, 255),
			math.random(150, 255)
		)
		
		addMessageToChat(scrollFrame, player.Name, message, playerColor)
		inputBox.Text = ""
	end
	
	inputBox:ReleaseFocus()
end

-- Функция закрытия чата
local function closeChat()
	if not isActive then return end
	
	isActive = false
	print("🔄 Закрываю чат...")
	
	-- Плавное исчезновение
	for i = 1, 20 do
		if mainScreenGui:FindFirstChild("ChatFrame") then
			mainScreenGui.ChatFrame.BackgroundTransparency = i/20
			mainScreenGui.ChatFrame.TopBar.BackgroundTransparency = i/20
			mainScreenGui.ChatFrame.UIStroke.Transparency = i/20
		end
		task.wait(0.02)
	end
	
	-- Удаляем GUI
