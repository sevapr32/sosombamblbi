-- Вставьте в ServerScriptService
-- Создает один новый сервер и перемещает туда всех игроков

local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

local function moveAllPlayersToNewServer()
    local players = Players:GetPlayers()
    if #players > 0 then
        local teleportOptions = Instance.new("TeleportOptions")
        pcall(function()
            TeleportService:TeleportAsync(game.PlaceId, players, teleportOptions)
        end)
    end
end

-- Ждем 5 секунд после старта, затем создаем сервер
wait(5)
moveAllPlayersToNewServer()

-- Для игроков, которые зашли позже
Players.PlayerAdded:Connect(function(player)
    wait(3)
    moveAllPlayersToNewServer()
end)
