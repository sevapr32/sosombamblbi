-- Вставьте этот скрипт в ServerScriptService
-- Он автоматически создаст GUI у игрока и переместит его в новый сервер

local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Определяем, работает ли код на сервере
local IS_SERVER = RunService:IsServer()

-- Главная функция создания нового публичного сервера
local function createNewPublicServer(player)
    local placeId = game.PlaceId
    
    -- Сообщение игроку
    if player and player:FindFirstChild("PlayerGui") then
        local message = Instance.new("Message")
        message.Text = "🌀 Создаем новый сервер..."
        message.Parent = player.PlayerGui
        game.Debris:AddItem(message, 3)
    end
    
    -- Опции телепортации для публичного сервера
    local teleportOptions = Instance.new("TeleportOptions")
    teleportOptions.ShouldReserveServer = false
    
    -- Добавляем данные о телепортации
    teleportOptions:SetTeleportData({
        sourceServer = game.JobId,
        timestamp = os.time(),
        playerName = player and player.Name or "Unknown"
    })
    
    -- Список игроков для телепортации
    local playersToTeleport = {player}
    
    -- Пытаемся создать новый сервер
    local success, errorMsg = pcall(function()
        TeleportService:TeleportAsync(placeId, playersToTeleport, teleportOptions)
    end)
    
    if not success then
        warn("Ошибка создания сервера: " .. tostring(errorMsg))
        if player and player:FindFirstChild("PlayerGui") then
            local errorMsg = Instance.new("Message")
            errorMsg.Text = "❌ Ошибка: " .. tostring(errorMsg):sub(1, 50)
            errorMsg.Parent = player.PlayerGui
            game.Debris:AddItem(errorMsg, 5)
        end
    end
    
    return success
end

-- Функция создания GUI для игрока
local function createServerGUI(player)
    -- Ждем загрузки GUI игрока
    if not player:WaitForChild("PlayerGui", 5) then
        warn("Не удалось загрузить PlayerGui для " .. player.Name)
        return
    end
    
    -- Создаем основной интерфейс
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ServerCreatorGUI"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    -- Основной фрейм
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 350, 0, 200)
    mainFrame.Position = UDim2.new(0.5, -175, 0.5, -100)
    mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = screenGui
    
    -- Закругление углов
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = mainFrame
    
    -- Тень/эффект глубины
    local shadow = Instance.new("UIStroke")
    shadow.Color = Color3.fromRGB(0, 0, 0)
    shadow.Thickness = 2
    shadow.Transparency = 0.7
    shadow.Parent = mainFrame
    
    -- Заголовок
    local title = Instance.new("TextLabel")
    title.Text = "🔄 СОЗДАНИЕ СЕРВЕРА"
    title.Size = UDim2.new(1, 0, 0, 50)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundColor3 = Color3.fromRGB(0, 90, 175)
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 22
    title.TextWrapped = true
    title.Parent = mainFrame
    
    local titleCorner = Instance.new("UICorner")
    titleCorner.CornerRadius = UDim.new(0, 12)
    titleCorner.Parent = title
    
    -- Информационная панель
    local infoPanel = Instance.new("Frame")
    infoPanel.Size = UDim2.new(0.9, 0, 0, 60)
    infoPanel.Position = UDim2.new(0.05, 0, 0.3, 0)
    infoPanel.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    infoPanel.BorderSizePixel = 0
    infoPanel.Parent = mainFrame
    
    local infoCorner = Instance.new("UICorner")
    infoCorner.CornerRadius = UDim.new(0, 8)
    infoCorner.Parent = infoPanel
    
    local infoText = Instance.new("TextLabel")
    infoText.Text = "📊 Текущий сервер будет закрыт\n🚀 Вы будете перемещены в новый инстанс"
    infoText.Size = UDim2.new(1, -20, 1, -10)
    infoText.Position = UDim2.new(0, 10, 0, 5)
    infoText.BackgroundTransparency = 1
    infoText.TextColor3 = Color3.fromRGB(220, 220, 220)
    infoText.Font = Enum.Font.SourceSans
    infoText.TextSize = 16
    infoText.TextWrapped = true
    infoText.TextXAlignment = Enum.TextXAlignment.Left
    infoText.Parent = infoPanel
    
    -- Главная кнопка
    local createButton = Instance.new("TextButton")
    createButton.Name = "CreateButton"
    createButton.Text = "🚀 СОЗДАТЬ НОВЫЙ СЕРВЕР"
    createButton.Size = UDim2.new(0.8, 0, 0, 50)
    createButton.Position = UDim2.new(0.1, 0, 0.75, 0)
    createButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    createButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    createButton.Font = Enum.Font.SourceSansBold
    createButton.TextSize = 18
    createButton.AutoButtonColor = true
    createButton.Parent = mainFrame
    
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 8)
    buttonCorner.Parent = createButton
    
    local buttonStroke = Instance.new("UIStroke")
    buttonStroke.Color = Color3.fromRGB(255, 255, 255)
    buttonStroke.Thickness = 2
    buttonStroke.Transparency = 0.5
    buttonStroke.Parent = createButton
    
    -- Индикатор загрузки (изначально скрыт)
    local loadingFrame = Instance.new("Frame")
    loadingFrame.Name = "LoadingFrame"
    loadingFrame.Size = UDim2.new(1, 0, 1, 0)
    loadingFrame.Position = UDim2.new(0, 0, 0, 0)
    loadingFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    loadingFrame.BackgroundTransparency = 0.3
    loadingFrame.Visible = false
    loadingFrame.Parent = mainFrame
    
    local loadingText = Instance.new("TextLabel")
    loadingText.Text = "🌀 Создаем новый сервер...\nПожалуйста, подождите"
    loadingText.Size = UDim2.new(1, 0, 0, 60)
    loadingText.Position = UDim2.new(0, 0, 0.5, -30)
    loadingText.BackgroundTransparency = 1
    loadingText.TextColor3 = Color3.fromRGB(255, 255, 255)
    loadingText.Font = Enum.Font.SourceSansBold
    loadingText.TextSize = 18
    loadingText.TextWrapped = true
    loadingText.Parent = loadingFrame
    
    -- Анимация загрузки
    local loadingDots = Instance.new("TextLabel")
    loadingDots.Text = "..."
    loadingDots.Size = UDim2.new(1, 0, 0, 30)
    loadingDots.Position = UDim2.new(0, 0, 0.7, 0)
    loadingDots.BackgroundTransparency = 1
    loadingDots.TextColor3 = Color3.fromRGB(0, 150, 255)
    loadingDots.Font = Enum.Font.SourceSansBold
    loadingDots.TextSize = 24
    loadingDots.Parent = loadingFrame
    
    -- Функция для анимации точек
    local dotCount = 0
    local function animateDots()
        dotCount = (dotCount % 3) + 1
        loadingDots.Text = string.rep(".", dotCount)
    end
    
    -- Подключаем обработчик клика
    createButton.MouseButton1Click:Connect(function()
        -- Показываем анимацию загрузки
        loadingFrame.Visible = true
        createButton.Visible = false
        
        -- Запускаем анимацию точек
        local connection
        connection = game:GetService("RunService").Heartbeat:Connect(function()
            animateDots()
        end)
        
        -- Создаем новый сервер
        local success = createNewPublicServer(player)
        
        -- Останавливаем анимацию
        if connection then
            connection:Disconnect()
        end
        
        if not success then
            -- Если не удалось, показываем кнопку снова
            loadingFrame.Visible = false
            createButton.Visible = true
            createButton.Text = "🔄 ПОВТОРИТЬ ПОПЫТКУ"
            createButton.BackgroundColor3 = Color3.fromRGB(215, 60, 0)
        end
    end)
    
    -- Эффекты при наведении
    createButton.MouseEnter:Connect(function()
        createButton.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
        buttonStroke.Transparency = 0.2
    end)
    
    createButton.MouseLeave:Connect(function()
        createButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        buttonStroke.Transparency = 0.5
    end)
    
    -- Добавляем возможность перетаскивания окна
    local dragging = false
    local dragStart, frameStart
    
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            frameStart = mainFrame.Position
        end
    end)
    
    title.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                frameStart.X.Scale, 
                frameStart.X.Offset + delta.X,
                frameStart.Y.Scale,
                frameStart.Y.Offset + delta.Y
            )
        end
    end)
    
    -- Кнопка закрытия (опционально)
    local closeButton = Instance.new("TextButton")
    closeButton.Text = "✕"
    closeButton.Size = UDim2.new(0, 30, 0, 30)
    closeButton.Position = UDim2.new(1, -35, 0, 10)
    closeButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.Font = Enum.Font.SourceSansBold
    closeButton.TextSize = 18
    closeButton.Parent = mainFrame
    
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(1, 0)
    closeCorner.Parent = closeButton
    
    closeButton.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)
    
    closeButton.MouseEnter:Connect(function()
        closeButton.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
    end)
    
    closeButton.MouseLeave:Connect(function()
        closeButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    end)
    
    -- Добавляем GUI игроку
    screenGui.Parent = player.PlayerGui
    
    -- Автоматически создаем сервер через 5 секунд после захода первого игрока
    if #Players:GetPlayers() == 1 then
        spawn(function()
            wait(5)
            if createButton and createButton.Parent then
                createButton:Fire("MouseButton1Click")
            end
        end)
    end
    
    return screenGui
end

-- Основная логика сервера
if IS_SERVER then
    print("🔄 Скрипт создания сервера запущен!")
    
    -- Функция обработки подключения игрока
    local function onPlayerAdded(player)
        print("🎮 Игрок подключился: " .. player.Name)
        
        -- Ждем немного и создаем GUI
        player:WaitForChild("PlayerGui")
        wait(1)
        
        -- Создаем интерфейс для игрока
        local success, errorMsg = pcall(function()
            createServerGUI(player)
        end)
        
        if not success then
            warn("Ошибка создания GUI: " .. tostring(errorMsg))
        end
    end
    
    -- Обработка отключения игрока
    local function onPlayerRemoving(player)
        print("👋 Игрок отключился: " .. player.Name)
    end
    
    -- Подключаем обработчики событий
    Players.PlayerAdded:Connect(onPlayerAdded)
    Players.PlayerRemoving:Connect(onPlayerRemoving)
    
    -- Обработка уже подключенных игроков
    for _, player in ipairs(Players:GetPlayers()) do
        spawn(function()
            onPlayerAdded(player)
        end)
    end
    
    -- Команда в чат для создания сервера
    Players.PlayerAdded:Connect(function(player)
        player.Chatted:Connect(function(message)
            local cmd = string.lower(message)
            if cmd == "/новыйсервер" or cmd == "/newserver" or cmd == "/ns" then
                createNewPublicServer(player)
            end
        end)
    end)
    
    -- Информация в вывод
    print("📊 Система готова к созданию серверов")
    print("📍 Place ID: " .. game.PlaceId)
    print("🆔 Server ID: " .. game.JobId)
else
    warn("⚠️ Этот скрипт должен быть запущен на сервере (ServerScriptService)!")
end

-- Экспорт функций для возможного использования из других скриптов
return {
    CreateNewServer = createNewPublicServer,
    CreateServerGUI = createServerGUI
}
